model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

annotation PBI_QueryOrder = ["daily_market_summary","dim_company","dim_date","fact_daily_quotes","sector_summary","top_movers"]

ref table daily_market_summary
ref table dim_company
ref table dim_date
ref table fact_daily_quotes
ref table sector_summary
ref table top_movers
ref table _Measures

ref cultureInfo en-US

