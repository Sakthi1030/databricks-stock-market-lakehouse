# Copy to .env for local runs. .env is gitignored; never commit real secrets.

# Radar (python -m radar run): all optional locally. Without Gemini, a keyword classifier is used.
GEMINI_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_TO=

# API (uvicorn backend.main:app): the Databricks SQL Warehouse that serves the Gold tables.
# Host and HTTP path: SQL Warehouses -> your warehouse -> Connection details.
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
