# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# Finnhub (finnhub.io) — free tier, no credit card required
FINNHUB_API_KEY=your_finnhub_api_key_here

# Databricks — same SQL Warehouse Power BI connects to.
# Host and HTTP path: SQL Warehouses -> your warehouse -> Connection details tab.
# Token: Settings -> Developer -> Manage access tokens -> Generate new token.
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# Environment name: dev | prod
ENVIRONMENT=dev
