# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# Finnhub (finnhub.io) — free tier, no credit card required
FINNHUB_API_KEY=your_finnhub_api_key_here

# Databricks (filled in during automation step)
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Environment name: dev | prod
ENVIRONMENT=dev
